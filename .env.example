# ── Configuracion de Base de Datos ──
# PostgreSQL portable (por defecto en modo standalone)
DATABASE_URL=postgresql://techstock:techstock@localhost:5433/techstock

# PostgreSQL externo (si ya tiene uno instalado)
# DATABASE_URL=postgresql://usuario:password@localhost:5432/inventario

# ── Entorno ──
# ENVIRONMENT=development
# TESTING=false
# LOG_LEVEL=INFO

# ── Seguridad ──
# COOKIE_SECURE=false
# SECURITY_HEADERS=true
# IDLE_TIMEOUT_MINUTES=30

# ── Chatbot IA (opcional, sin esto funciona en modo offline) ──
# GEMINI_API_KEY=AIza...
# CHATBOT_AI_ENABLED=true
# CHATBOT_AI_MODEL=gemini-2.5-flash
